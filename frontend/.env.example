# Leave both unset for local development: the app then signs in as dev@localhost.
# Set both (Supabase dashboard > Project Settings > API) to use real sign-in.
# REACT_APP_SUPABASE_URL=https://<project-ref>.supabase.co
# REACT_APP_SUPABASE_ANON_KEY=<anon / publishable key>

# Optional. Leave unset to call the API at /api on the same origin.
# REACT_APP_API_URL=https://your-api.example.com/api
